# ──────────────────────────────────────────────────────────────
# AgriSense AI backend environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# ──────────────────────────────────────────────────────────────

# Django
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=api.agrisense.example,localhost,127.0.0.1
SECURE_SSL_REDIRECT=False

# Database (MySQL 8 / MariaDB 10.6+)
DB_ENGINE=django.db.backends.mysql
DB_NAME=agrisense_db
DB_USER=agrisense_user
DB_PASSWORD=password123
DB_HOST=localhost
DB_PORT=3306

# CORS (comma-separated list of allowed origins when CORS_ALLOW_ALL=false)
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Channels / WebSockets (redis in production)
CHANNEL_LAYER_BACKEND=memory
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/0

# Throttling
THROTTLE_AUTH_RATE=10/min
THROTTLE_AI_RATE=20/min
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=120/min

# Weather (get a free key at https://openweathermap.org/api)
OPENWEATHER_API_KEY=
# Weather response cache (seconds) + retention for DB pruning (days)
WEATHER_CACHE_TTL=900
WEATHER_RETENTION_DAYS=30

# Caching — locmem (dev/test, no server) | redis (production)
CACHE_BACKEND=locmem
REDIS_CACHE_URL=redis://127.0.0.1:6379/2

# Celery — leave CELERY_BROKER_URL empty for eager mode (dev/test); set to a
# Redis URL in production and run the worker/beat services (see docker-compose).
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_ALWAYS_EAGER=true

# Logging — JSON structured logs in production
JSON_LOGS=true
LOG_LEVEL=INFO

# Sentry (optional error tracking)
SENTRY_DSN=

# Phone OTP / SMS (Phase D)
# SMS_PROVIDER: noop (logs code; debug returns it) | africastalking | twilio
SMS_PROVIDER=noop
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Require a verified phone OTP before registration / password reset.
OTP_REQUIRED_FOR_REGISTRATION=false
OTP_REQUIRED_FOR_PASSWORD_RESET=false
# Africa's Talking (when SMS_PROVIDER=africastalking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=

# Internationalization (backend API messages; UI localization lives in Flutter)
LANGUAGE_CODE=en-us

# IoT / USSD (Phase F)
# USSD handler throttle scope
THROTTLE_USSD_RATE=20/min

# Precision irrigation (innovation #2)
# Re-alert throttle per sensor (hours) when soil is dry.
IRRIGATION_ALERT_THROTTLE_HOURS=6

# Predictive outbreak alerting (innovation #4)
OUTBREAK_RECENT_DAYS=7
OUTBREAK_MIN_CLUSTER_SIZE=3
OUTBREAK_GROWTH_FACTOR=2.0
OUTBREAK_COOLDOWN_HOURS=24
OUTBREAK_NOTIFY_RADIUS_DEG=0.8

# Payments — see docs/PAYMENTS_SETUP.md.
# Local simulator is TEST ONLY and never moves money. It is on by default when
# DEBUG=True (set false to disable). Simulated payments always succeed, so
# demos are reliable; a number ending in 0000 (e.g. +237 670 00 00 00)
# simulates a declined payment for failure-path testing.
# Outside DEBUG it stays off unless PAYMENT_SIMULATOR_ALLOW_NON_DEBUG=true.
PAYMENT_SIMULATOR_ENABLED=true
PAYMENT_SIMULATOR_ALLOW_NON_DEBUG=false
PAYMENT_PROVIDER_TIMEOUT_SECONDS=12
MTN_MOMO_ENABLED=false
MTN_MOMO_API_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_PRIMARY_KEY=
# sandbox = EUR test money; mtncameroon = live XAF with approved live credentials.
MTN_MOMO_ENVIRONMENT=sandbox
# Empty uses the MTN sandbox host / live proxy host. Confirm your live host with MTN.
MTN_MOMO_BASE_URL=
# Optional live callback; must match the host registered with MTN. Polling still runs.
MTN_MOMO_CALLBACK_URL=
# Orange Money / cards are not implemented. No enable flag can make them live.

# Premium pricing (FCFA per month)
PREMIUM_PRICE_PER_MONTH=1000

# Money-flow (Phase A)
# How long an unpaid order holds stock before the reconciler releases it.
ORDER_RESERVATION_MINUTES=30
# Platform commission applied at delivery settlement (0.0 = none).
PLATFORM_COMMISSION_RATE=0.0
# Shared secret used to HMAC-sign payment webhook callbacks. Long + random in prod.
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret

# Realtime / push (Phase B)
# 'noop' (default) uses in-app WebSocket notifications only. 'fcm' adds real
# push notifications via Firebase (requires FCM_CREDENTIALS_PATH service-account).
PUSH_PROVIDER=noop
FCM_CREDENTIALS_PATH=

# Plant-pathology inference — pick ONE engine:
#   groq       free tier, fastest hosted option (recommended; console.groq.com/keys)
#   openrouter free-tier router (openrouter.ai/keys)
#   ollama     self-hosted, no provider quota (you supply the hardware)
# Obtain the key from the provider and set it privately in the backend
# environment; never place a real key in source control or the Flutter app.
AI_ENGINE=openrouter
OPENROUTER_API_KEY=
# Dynamically select currently available free vision + structured-output models.
# Avoids hard-coded retired slugs. A specific :free model may be used after checking:
#   python manage.py check_ai_model --check-auth
#   python manage.py check_ai_model --list-free
OPENROUTER_MODEL=openrouter/free
# Pinned free vision models tried in order if the auto-router is throttled or
# down. Free slugs are retired regularly — refresh this list with:
#   python manage.py check_ai_model --list-free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free router/:free only + provider max_price=0; never silently use a paid model.
OPENROUTER_ALLOW_PAID_MODELS=false
OPENROUTER_TIMEOUT_SECONDS=25
OPENROUTER_IMAGE_MAX_DIMENSION=1024
OPENROUTER_IMAGE_QUALITY=82
OPENROUTER_CONFIDENCE_THRESHOLD=70
OPENROUTER_MAX_CONFIDENCE=95
OPENROUTER_APP_URL=
OPENROUTER_APP_TITLE=AgriSense AI
AI_CROP_CONFIDENCE_THRESHOLD=65
AI_MAX_UPLOAD_BYTES=10485760
AI_ANALYSIS_CACHE_SECONDS=600

# Self-hosted free vision model (AI_ENGINE=ollama). No provider daily quota;
# you supply the compute. Install/pull the model before use. See docs/AI_SETUP.md.
# For Docker Compose's local-ai profile use http://ollama:11434 instead.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_SECONDS=25

# Groq free-tier vision (AI_ENGINE=groq) — recommended free option.
# Create a free API key (no credit card) at https://console.groq.com/keys.
# Free tier: ~30 requests/minute and a per-model daily quota tracked per key
# (model dependent, comfortably above 50 scans/day; check
# console.groq.com/settings/limits). Groq inference is very fast (LPU), so a
# scan normally returns in a few seconds. Same crop/non-crop guards as every
# engine; only reviewed diseases can ever be returned.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_FALLBACK_MODELS=meta-llama/llama-4-maverick-17b-128e-instruct
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=25
GROQ_MAX_TOKENS=1024
GROQ_IMAGE_MAX_DIMENSION=1024
GROQ_IMAGE_QUALITY=82

# The model can select ONLY Disease rows reviewed in the database for the crop.
# It never supplies treatment text; medication/instructions come from the DB.
AI_MAX_IMAGE_PIXELS=25000000
AI_REQUIRE_TRAINED_MODEL=true
AI_ALLOW_RULE_FALLBACK=false

# Optional local TensorFlow engine (set AI_ENGINE=tensorflow).
AI_MODEL_PATH=
AI_CLASS_MAP_PATH=
AI_MODEL_VERSION=
AI_MODEL_INPUT_SIZE=224x224
# zero_one | minus_one_one (MobileNet preprocess) | imagenet | none
AI_MODEL_NORMALIZATION=zero_one
AI_MODEL_OUTPUT_NAME=
AI_MODEL_CONFIDENCE_THRESHOLD=65.0
AI_MODEL_TEMPERATURE=1.0
AI_STRICT_CLASS_COUNT=true

# Demo rule engine (set AI_ENGINE=rules explicitly).
AI_TEMPERATURE=1.6
AI_LOW_CONFIDENCE_THRESHOLD=80.0
