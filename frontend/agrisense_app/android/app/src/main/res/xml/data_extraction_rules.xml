<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup / device-transfer rules for Android 12+ (android:dataExtractionRules).

  Same reasoning as backup_rules.xml: the pre-populated knowledge base is part
  of the APK, so it must never travel through cloud backup or device-to-device
  transfer. Re-installing it from the bundled asset is always cheaper and always
  produces the version that matches the installed app.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="app_flutter/databases/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_flutter/databases/" />
    </device-transfer>
</data-extraction-rules>
