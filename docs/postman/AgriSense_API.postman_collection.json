{
  "info": {
    "_postman_id": "agrisense-api-collection",
    "name": "AgriSense API",
    "description": "Complete Postman collection for testing the AgriSense Django REST + Channels backend. Import alongside the `AgriSense Local` environment, then run **Login** first to populate the access token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-refresh JWT if it's about to expire (5-min buffer)",
          "const expiry = pm.environment.get('access_token_expiry');",
          "if (expiry && Date.now() > Number(expiry) - 5 * 60 * 1000) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('base_url') + '/api/auth/refresh/',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({",
          "      refresh: pm.environment.get('refresh_token')",
          "    }) }",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) {",
          "      const json = res.json();",
          "      pm.environment.set('access_token', json.access);",
          "      pm.environment.set('access_token_expiry', Date.now() + 5 * 60 * 1000);",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Health (no auth)",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health/",
              "host": ["{{base_url}}"],
              "path": ["api", "health", ""]
            }
          }
        }
      ]
    },
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Login (capture JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "  pm.environment.set('access_token', json.access);",
                  "  pm.environment.set('refresh_token', json.refresh);",
                  "  pm.environment.set('access_token_expiry', Date.now() + 5 * 60 * 1000);",
                  "  if (json.user_id) pm.environment.set('user_id', json.user_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access) {",
                  "  pm.environment.set('access_token', json.access);",
                  "  pm.environment.set('access_token_expiry', Date.now() + 5 * 60 * 1000);",
                  "}",
                  "if (json.refresh) pm.environment.set('refresh_token', json.refresh);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/refresh/",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "refresh", ""]
            }
          }
        },
